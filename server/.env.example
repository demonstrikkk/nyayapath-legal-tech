# ---------------------------------------------------------------------------
# JollyLLM - live model configuration
#
# Copy this file to .env and fill in a real key:
#     server\.env
#
# .env is git-ignored. NEVER commit a real key, never put the key in web/,
# and never expose it through a VITE_ variable - Vite inlines VITE_* values
# into the client bundle and they would be visible in the browser.
#
# With nothing set here the app runs in deterministic mode and every feature
# still works. See .env.example for placeholder values only.
# ---------------------------------------------------------------------------

# Set to false to force deterministic mode even when a key is present.
LLM_ENABLED=true

# groq | openai | generic  (generic = any OpenAI-compatible /chat/completions URL)
LLM_PROVIDER=groq

# Your real provider key. Server-side only.
LLM_API_KEY=replace-with-your-real-key

# Model id must be one your provider actually serves.
#
# The fastest free chat model on Groq. The openai/gpt-oss models are
# reasoning models: they burn 150+ reasoning tokens before answering, which
# makes them several times slower and far more expensive against a
# per-minute token limit.
LLM_MODEL=qwen/qwen3.8-27b

# Fallback models, tried in order when the primary one cannot be used.
#
# Providers meter quota per model, so a model whose daily budget is spent
# does not stop a different model from answering. Listing at least one
# fallback keeps the app answering when the primary model's quota runs out.
# Comma separated.
# LLM_FALLBACK_MODELS=openai/gpt-oss-20b,openai/gpt-oss-120b

# Leave unset for the provider default shown above.
# Groq:      https://api.groq.com/openai/v1
# OpenAI:    https://api.openai.com/v1
LLM_BASE_URL=https://api.groq.com/openai/v1

# Request handling.
# A reasoning model asked for 2,000 tokens regularly needs 15-25 seconds, so
# this has to be well above that. The total time the model may take is
# capped in code (AI_BUDGET) and must stay under ANALYZE_DEADLINE_MS.
LLM_TIMEOUT_MS=25000
LLM_MAX_ATTEMPTS=2

# Set to false if your provider does not support response_format=json_object
LLM_JSON_MODE=true

# Lawyer directory
# Keep false in production. The bundled profiles are fictional demo data and are
# returned only when this is explicitly true. They are always labelled as demo.
LAWYER_DIRECTORY_DEMO=false

# ---------------------------------------------------------------------------
# Live legal dataset (optional)
# ---------------------------------------------------------------------------
# A datagoblin instance holding scraped legal records. When these are set,
# case research also queries the live dataset and the statutes and decisions
# it relies on are recorded against the case.
#
# The API key stays on the server. It is never sent to the browser, and only
# the legal search text leaves this process - never the client's narrative,
# name, or documents.
#
# With none of these set, the app runs on the bundled corpus exactly as before.
# DATAGOBLIN_BASE_URL=http://127.0.0.1:8000
# DATAGOBLIN_API_KEY=replace-with-your-real-key
# DATAGOBLIN_LEGAL_DATASET_ID=
